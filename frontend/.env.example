# Copy to .env.local for `npm run dev`. scripts/deploy-frontend.sh writes .env.production.local
# from the Terraform outputs automatically. None of these are secrets: they all end up in the
# browser bundle, which is why the app client has no secret.
VITE_REGION=eu-west-1
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com
VITE_USER_POOL_ID=eu-west-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
